    {
      "id": "handoff-roundtrip",
      "requirement": "真实双向Handoff含暂存、二进制、未跟踪文件；关联副本复用；旧终端身份清楚"
    },
    {
      "id": "dirty-target-and-recovery",
      "requirement": "脏目标拒绝，注入中断后可预览并恢复到新副本，未知改动保留"
    },
    {
      "id": "archive-pin-retention",
      "requirement": "会话固定保护，归档后列表/快照恢复，限额与真实磁盘状态一致"
    },
    {
      "id": "environment-actions",
      "requirement": "环境setup/平台覆盖/动作日志，重复请求不重复执行，批准/取消/失败可操作"
    },
    {
      "id": "reconnect-and-narrow",
      "requirement": "断线/重连恢复操作、准备中输入不重复；280dp大字体主要操作可触达"
    },
    {
      "id": "codex-parity",
      "requirement": "逐项核对README公开基线及官方页面；记录实际差异，未解决差异不能PASS"
    }
