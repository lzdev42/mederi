-- ============================================================
-- Mederi 数据库（data.db）
-- ============================================================
-- 会话运行数据：sessions、message_history、diffs。
-- 特性：高频写（append-heavy）、体积随使用增长。
-- 开发期（未发布）schema 可破坏性变更：直接删除本文件重建，配置（config.db）无损。

-- ============================================================
-- 会话表
-- ============================================================
-- Session 不引用 Agent，只记录用户最后一次选择的
-- agent_mode / ai_model / reasoning_level。系统提示词由 agentMode 动态决定。
-- ai_model 存储 AIModel 的 JSON 序列化（modelId + thinkingLevel + 模型元信息）。
-- project_id 表示该 Session 所属的项目，Agent 的读写权限作用于该项目下的目录。

CREATE TABLE IF NOT EXISTS sessions (
    id              TEXT NOT NULL,
    project_id      TEXT NOT NULL,
    title           TEXT NOT NULL DEFAULT '',
    status          TEXT NOT NULL DEFAULT 'IDLE',
    agent_mode      TEXT NOT NULL DEFAULT 'AUTONOMOUS',
    ai_model        TEXT,
    reasoning_level TEXT,
    api_key_id      TEXT,
    env             TEXT NOT NULL DEFAULT '{}',
    todos           TEXT NOT NULL DEFAULT '[]',
    active_skills   TEXT NOT NULL DEFAULT '[]',
    draft_text      TEXT,
    created_at      TEXT NOT NULL,
    updated_at      TEXT NOT NULL,
    workspace_id    TEXT,
    associated_worktree_id TEXT,
    archived_at     TEXT,
    pinned          INTEGER NOT NULL DEFAULT 0,
    subagent_configs TEXT NOT NULL DEFAULT '{}',
    subagent_max_concurrent INTEGER,
    PRIMARY KEY (id)
);

CREATE INDEX IF NOT EXISTS idx_sessions_project ON sessions(project_id);

-- 插入会话
insertSession:
INSERT INTO sessions (id, project_id, title, status, agent_mode, ai_model, reasoning_level, api_key_id, env, todos, active_skills, draft_text, created_at, updated_at, workspace_id, associated_worktree_id, archived_at, pinned, subagent_configs, subagent_max_concurrent)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- 查询所有会话（按更新时间降序）
listSessions:
SELECT id, project_id, title, status, agent_mode, ai_model, reasoning_level, api_key_id, env, todos, active_skills, draft_text, created_at, updated_at, workspace_id, associated_worktree_id, archived_at, pinned, subagent_configs, subagent_max_concurrent
FROM sessions
ORDER BY updated_at DESC;

-- 按 ID 查询会话
getSession:
SELECT id, project_id, title, status, agent_mode, ai_model, reasoning_level, api_key_id, env, todos, active_skills, draft_text, created_at, updated_at, workspace_id, associated_worktree_id, archived_at, pinned, subagent_configs, subagent_max_concurrent
FROM sessions
WHERE id = ?;

-- 按项目查询会话
listSessionsByProject:
SELECT id, project_id, title, status, agent_mode, ai_model, reasoning_level, api_key_id, env, todos, active_skills, draft_text, created_at, updated_at, workspace_id, associated_worktree_id, archived_at, pinned, subagent_configs, subagent_max_concurrent
FROM sessions
WHERE project_id = ?
ORDER BY updated_at DESC;

-- 更新会话 todo 列表（整体替换；唯一真理源 = sessions.todos 列）
updateSessionTodos:
UPDATE sessions SET todos = ?
WHERE id = ?;

-- 更新会话已激活 skill 列表（整体替换；唯一真理源 = sessions.active_skills 列）
updateSessionActiveSkills:
UPDATE sessions SET active_skills = ?
WHERE id = ?;

-- 会话级子代理覆盖：字段独立写入，不影响输入框与工作区状态
updateSessionSubagentConfigs:
UPDATE sessions SET subagent_configs = ? WHERE id = ?;

updateSessionSubagentMaxConcurrent:
UPDATE sessions SET subagent_max_concurrent = ? WHERE id = ?;

-- 更新会话状态
updateSessionStatus:
UPDATE sessions SET status = ?, updated_at = ?
WHERE id = ?;

-- 更新会话标题
updateSessionTitle:
UPDATE sessions SET title = ?
WHERE id = ?;

-- 更新会话 Agent 配置（COALESCE 使 NOT NULL 的列可接受 null 参数）
updateSessionAgentConfig:
UPDATE sessions SET agent_mode = COALESCE(?, agent_mode), ai_model = COALESCE(?, ai_model), reasoning_level = COALESCE(?, reasoning_level), api_key_id = COALESCE(?, api_key_id), updated_at = ?
WHERE id = ?;

-- 全量覆盖写会话 compose state（非 COALESCE：null 写 null，用于输入框设置统一保存）
updateSessionComposeState:
UPDATE sessions SET agent_mode = ?, ai_model = ?, reasoning_level = ?, api_key_id = ?, draft_text = ?
WHERE id = ?;

-- 删除会话
deleteSession:
DELETE FROM sessions
WHERE id = ?;

-- 更新会话工作区绑定
updateSessionWorkspaceBinding:
UPDATE sessions SET workspace_id = ?, associated_worktree_id = ?, updated_at = ?
WHERE id = ?;

-- 更新会话归档时间
updateSessionArchivedAt:
UPDATE sessions SET archived_at = ?, updated_at = ?
WHERE id = ?;

-- 更新会话固定状态
updateSessionPinned:
UPDATE sessions SET pinned = ?, updated_at = ?
WHERE id = ?;


-- ============================================================
-- 对话历史表
-- ============================================================
-- 存储每个 session 的完整对话历史。
-- 每条消息有序号 seq，支持回退（删除 seq 之后的消息）。
-- 完整的 Message 对象以 JSON 序列化存储在 payload 列（存储即真相，原始消息直读走 payload）。
-- 诊断列（model_id/duration_ms/finish_reason/status）写入时从 Message 抽取：
-- 原始消息查看器可直接按模型筛选、按时长排序，无需逐行解 JSON。

CREATE TABLE IF NOT EXISTS message_history (
    session_id    TEXT NOT NULL,
    seq           INTEGER NOT NULL,
    message_id    TEXT,
    role          TEXT NOT NULL,
    content       TEXT NOT NULL,
    payload       TEXT NOT NULL,
    created_at    TEXT NOT NULL,
    model_id      TEXT,
    duration_ms   INTEGER,
    finish_reason TEXT,
    status        TEXT,
    PRIMARY KEY (session_id, seq)
);

CREATE INDEX IF NOT EXISTS idx_message_session ON message_history(session_id, seq);

-- 加载完整历史（按序号升序）
loadBySession:
SELECT seq, message_id, role, content, payload, created_at, model_id, duration_ms, finish_reason, status
FROM message_history
WHERE session_id = ?
ORDER BY seq ASC;

-- ── 定向写（内存真理源配套） ──
-- seq 密集不变量：seq = 列表位置（0..n-1 无空洞），append 的 seq = 内存列表长度。
-- updateHistory 差异化 = 公共前缀不动 + 中段删除 + 尾部平移 + 中段插入。

-- 范围删除 updateHistory 的旧中段（seq ∈ [from, to)）
deleteRegion:
DELETE FROM message_history
WHERE session_id = ? AND seq >= ? AND seq < ?;

-- 两阶段负偏移平移·第一阶段：后缀移入负值区
-- （SQLite 单语句 PK 上移必然唯一冲突；负值区与正 seq 无冲突）
shiftToNegative:
UPDATE message_history SET seq = -(seq + 1)
WHERE session_id = ? AND seq >= ?;

-- 两阶段负偏移平移·第二阶段：负值区移回原位 + delta
shiftFromNegative:
UPDATE message_history SET seq = -seq - 1 + ?
WHERE session_id = ? AND seq < 0;

-- 追加消息（seq 由调用方在同一事务中计算）
appendMessage:
INSERT INTO message_history (session_id, seq, message_id, role, content, payload, created_at, model_id, duration_ms, finish_reason, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- 全量替换前清空
deleteAllBySession:
DELETE FROM message_history
WHERE session_id = ?;

-- 删除 session 的所有消息
deleteBySession:
DELETE FROM message_history
WHERE session_id = ?;

-- 回退到指定消息点（删除 seq 之后的消息）
rollbackTo:
DELETE FROM message_history
WHERE session_id = ? AND seq > ?;

-- 获取摘要列表（不含 payload 列，用于列表预览）
listSummary:
SELECT seq, message_id, role, content, created_at
FROM message_history
WHERE session_id = ?
ORDER BY seq ASC;

-- 原始消息直读（调试用）：payload JSON 原样返回，不解析；诊断列一并返回供筛选
listRaw:
SELECT seq, message_id, role, payload, created_at, model_id, duration_ms, finish_reason, status
FROM message_history
WHERE session_id = ?
ORDER BY seq ASC;

-- 统计消息数
countBySession:
SELECT COUNT(*) FROM message_history
WHERE session_id = ?;


-- ============================================================
-- Diff 表
-- ============================================================
-- 存储每次 turn 产生的文件变更。
-- changes_json 存储 FileChange 列表的 JSON 序列化。
-- unified_diff 存储 git 风格的 unified diff 文本。

CREATE TABLE IF NOT EXISTS diffs (
    id                                  INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id                          TEXT NOT NULL,
    message_id                          TEXT,
    changes_json                        TEXT NOT NULL,
    unified_diff                        TEXT NOT NULL,
    created_at                          TEXT NOT NULL,
    workspace_id                        TEXT,
    checkout_root_at_creation           TEXT,
    project_relative_path_at_creation   TEXT,
    workspace_generation                INTEGER
);

CREATE INDEX IF NOT EXISTS idx_diffs_session_id ON diffs(session_id);
CREATE INDEX IF NOT EXISTS idx_diffs_message_id ON diffs(message_id);

-- 保存一次 diff
insertDiff:
INSERT INTO diffs (session_id, message_id, changes_json, unified_diff, created_at, workspace_id, checkout_root_at_creation, project_relative_path_at_creation, workspace_generation)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- 按 session 查询所有 diff（按创建时间升序）
listDiffs:
SELECT session_id, message_id, changes_json, unified_diff, created_at, workspace_id, checkout_root_at_creation, project_relative_path_at_creation, workspace_generation
FROM diffs
WHERE session_id = ?
ORDER BY created_at ASC;

-- 按 message_id 查询 diff
getDiffByMessage:
SELECT session_id, message_id, changes_json, unified_diff, created_at, workspace_id, checkout_root_at_creation, project_relative_path_at_creation, workspace_generation
FROM diffs
WHERE session_id = ? AND message_id = ?
LIMIT 1;

-- 查询 session 最近一次 diff
getLatestDiff:
SELECT session_id, message_id, changes_json, unified_diff, created_at, workspace_id, checkout_root_at_creation, project_relative_path_at_creation, workspace_generation
FROM diffs
WHERE session_id = ?
ORDER BY created_at DESC
LIMIT 1;

-- 删除 session 的所有 diff
deleteDiffsBySession:
DELETE FROM diffs
WHERE session_id = ?;

-- 更新消息分类/输入消费状态，不重建整段历史，不覆盖并发追加。
updateMessagePayload:
UPDATE message_history SET payload = ?, status = ?
WHERE session_id = ? AND message_id = ?;


-- ============================================================
-- 工作区表与操作表
-- ============================================================

CREATE TABLE IF NOT EXISTS workspaces (
    id                     TEXT NOT NULL PRIMARY KEY,
    project_id             TEXT NOT NULL,
    kind                   TEXT NOT NULL,
    state                  TEXT NOT NULL,
    associated_session_id  TEXT,
    updated_at             TEXT NOT NULL,
    payload                TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_workspaces_project ON workspaces(project_id);
CREATE INDEX IF NOT EXISTS idx_workspaces_session ON workspaces(associated_session_id);

insertWorkspace:
INSERT OR REPLACE INTO workspaces (id, project_id, kind, state, associated_session_id, updated_at, payload)
VALUES (?, ?, ?, ?, ?, ?, ?);

getWorkspace:
SELECT id, project_id, kind, state, associated_session_id, updated_at, payload
FROM workspaces
WHERE id = ?;

listWorkspacesByProject:
SELECT id, project_id, kind, state, associated_session_id, updated_at, payload
FROM workspaces
WHERE project_id = ?
ORDER BY updated_at DESC;

deleteWorkspace:
DELETE FROM workspaces
WHERE id = ?;

CREATE TABLE IF NOT EXISTS workspace_operations (
    id               TEXT NOT NULL PRIMARY KEY,
    idempotency_key  TEXT NOT NULL UNIQUE,
    project_id       TEXT NOT NULL,
    workspace_id     TEXT NOT NULL,
    state            TEXT NOT NULL,
    updated_at       TEXT NOT NULL,
    payload          TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_workspace_operations_project ON workspace_operations(project_id);
CREATE INDEX IF NOT EXISTS idx_workspace_operations_workspace ON workspace_operations(workspace_id);

insertWorkspaceOperation:
INSERT OR REPLACE INTO workspace_operations (id, idempotency_key, project_id, workspace_id, state, updated_at, payload)
VALUES (?, ?, ?, ?, ?, ?, ?);

getWorkspaceOperation:
SELECT id, idempotency_key, project_id, workspace_id, state, updated_at, payload
FROM workspace_operations
WHERE id = ?;

getWorkspaceOperationByIdempotencyKey:
SELECT id, idempotency_key, project_id, workspace_id, state, updated_at, payload
FROM workspace_operations
WHERE idempotency_key = ?;

listWorkspaceOperationsByProject:
SELECT id, idempotency_key, project_id, workspace_id, state, updated_at, payload
FROM workspace_operations
WHERE project_id = ?
ORDER BY updated_at DESC;

deleteWorkspaceOperation:
DELETE FROM workspace_operations
WHERE id = ?;
